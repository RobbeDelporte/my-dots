# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Superpowers brainstorm sessions + specs/plans
.superpowers/
docs/superpowers/

# Secrets (never commit)
.env
*.pem
*.key

# matugen-generated colour files (clobbered on every wallpaper render)
yazi/theme.toml

# All matugen-generated output is centralized here (untracked, regenerated on
# every wallpaper render). See README "matugen output flow".
generated/

# wayle: ~/.config/wayle is a whole-dir symlink to wayle/ (wayle atomically
# rewrites runtime.toml, which would break a per-file symlink). Track only the
# two config files; everything else is wayle-generated and regenerated by wayle.
wayle/*
!wayle/config.toml
!wayle/runtime.toml
