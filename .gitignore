# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Python bytecode (e.g. eww/place.py compiled into eww/__pycache__)
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# Superpowers brainstorm sessions + specs/plans
.superpowers/
docs/superpowers/

# Secrets (never commit)
.env
*.pem
*.key

# matugen-generated colour files (clobbered on every wallpaper render)
yazi/theme.toml

# All matugen-generated output is centralized here (untracked, regenerated on
# every wallpaper render). See README "matugen output flow".
generated/

# wayle: ~/.config/wayle is a whole-dir symlink to wayle/ (wayle atomically
# rewrites runtime.toml, which would break a per-file symlink). The wayle settings
# GUI writes runtime.toml — the SINGLE tracked source of truth. Everything else
# (config.toml hand-edit layer — unused/empty here, schema.json, etc.) is ignored.
wayle/*
!wayle/runtime.toml
# styles/index.scss is tracked; it imports the generated _colors.scss (ignored).
# git cannot re-include a file whose parent dir is excluded, so styles/ has to be
# un-excluded first, then its contents excluded again.
!wayle/styles/
wayle/styles/*
!wayle/styles/index.scss

# skwd-wall: ~/.config/skwd-wall-v2 is a whole-dir symlink to skwd/ (the picker
# rewrites config.json, which would break a per-file symlink). config.json is the
# SINGLE tracked source of truth. skwd seeds 21 of its own matugen templates into
# matugen/templates/ here — unused, since theming runs through this repo's
# matugen/config.toml via skwd's External Matugen setting.
skwd/*
!skwd/config.json
