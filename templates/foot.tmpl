# Generated by matugen — do NOT hand-edit (clobbered on every matugen run).
# foot colors: https://man.archlinux.org/man/foot.ini.5 (SECTION: colors-dark)
# Included by foot/foot.ini via `include` (last-wins over its static fallback).
# Hybrid palette, identical role mapping to kitty.tmpl: bg/fg/cursor/selection +
# neutrals + red/blue/magenta follow the matugen scheme; green/yellow/cyan are a
# static Catppuccin set because Material You has no green/yellow/cyan roles and
# matugen has no terminal_color_N roles.
# Two foot quirks vs kitty.tmpl: the section MUST be [colors-dark] (foot rejects
# a bare [colors], and dark is the theme it loads by default), and colours are
# 6-digit hex with NO leading `#` — hence hex_stripped throughout.
# ANSI 0-15 map onto regular0-7 (0-7) and bright0-7 (8-15).

[colors-dark]
background={{colors.surface.default.hex_stripped}}
foreground={{colors.on_surface.default.hex_stripped}}
# One key, two values: cursor text first, then the cursor block itself.
cursor={{colors.on_primary.default.hex_stripped}} {{colors.primary.default.hex_stripped}}
selection-background={{colors.primary_container.default.hex_stripped}}
selection-foreground={{colors.on_primary_container.default.hex_stripped}}

# Neutrals (themed) — ascending lightness: black < bright-black < white < bright-white
regular0={{colors.surface_container_highest.default.hex_stripped}}
bright0={{colors.outline.default.hex_stripped}}
regular7={{colors.on_surface_variant.default.hex_stripped}}
bright7={{colors.on_surface.default.hex_stripped}}

# Red — matugen error role
regular1={{colors.error.default.hex_stripped}}
bright1={{colors.error.default.hex_stripped}}

# Green — curated (Catppuccin); MatYou has no green role
regular2=a6e3a1
bright2=a6e3a1

# Yellow — curated (Catppuccin); MatYou has no yellow role
regular3=f9e2af
bright3=f9e2af

# Blue — matugen primary (hue tracks the wallpaper/scheme)
regular4={{colors.primary.default.hex_stripped}}
bright4={{colors.primary.default.hex_stripped}}

# Magenta — matugen tertiary (a saturated accent; secondary is too desaturated
# and collides with the neutral whites regular7/bright7)
regular5={{colors.tertiary.default.hex_stripped}}
bright5={{colors.tertiary.default.hex_stripped}}

# Cyan — curated (Catppuccin); MatYou has no cyan role
regular6=94e2d5
bright6=94e2d5
