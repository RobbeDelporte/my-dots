# Generated by matugen — do NOT hand-edit (clobbered on every matugen run).
# kitty colors: https://sw.kovidgoyal.net/kitty/conf/#color-scheme
# Included by kitty.conf; kitty re-reads it on SIGUSR1 (matugen post_hook).
# Hybrid palette: bg/fg/cursor/selection + neutrals + red/blue/magenta follow the
# matugen scheme; green/yellow/cyan are a static Catppuccin set because Material
# You has no green/yellow/cyan roles and no terminal_color_N roles.

background           {{colors.surface.default.hex}}
foreground           {{colors.on_surface.default.hex}}
cursor               {{colors.primary.default.hex}}
cursor_text_color    {{colors.on_primary.default.hex}}
selection_background {{colors.primary_container.default.hex}}
selection_foreground {{colors.on_primary_container.default.hex}}
url_color            {{colors.tertiary.default.hex}}

active_border_color   {{colors.primary.default.hex}}
inactive_border_color {{colors.outline.default.hex}}

# Neutrals (themed) — ascending lightness: black < bright-black < white < bright-white
color0  {{colors.surface_container_highest.default.hex}}
color8  {{colors.outline.default.hex}}
color7  {{colors.on_surface_variant.default.hex}}
color15 {{colors.on_surface.default.hex}}

# Red — matugen error role
color1  {{colors.error.default.hex}}
color9  {{colors.error.default.hex}}

# Green — curated (Catppuccin); MatYou has no green role
color2  #a6e3a1
color10 #a6e3a1

# Yellow — curated (Catppuccin); MatYou has no yellow role
color3  #f9e2af
color11 #f9e2af

# Blue — matugen primary (hue tracks the wallpaper/scheme)
color4  {{colors.primary.default.hex}}
color12 {{colors.primary.default.hex}}

# Magenta — matugen tertiary (a saturated accent; secondary is too desaturated
# and collides with the neutral whites color7/color15)
color5  {{colors.tertiary.default.hex}}
color13 {{colors.tertiary.default.hex}}

# Cyan — curated (Catppuccin); MatYou has no cyan role
color6  #94e2d5
color14 #94e2d5
