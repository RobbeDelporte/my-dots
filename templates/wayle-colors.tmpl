// Generated — do NOT hand-edit (rewritten on every wallpaper change).
// Imported by index.scss; overrides wayle's semantic colour variables so the
// bar consumes the wallpaper palette instead of its static styling.palette.
//
// IMPORTANT — skwd's Iris engine does NOT order the Material surface roles the
// way the spec does. Measured ordering, darkest first:
//     container_lowest < surface < container_low < variant
//         < container_HIGH < container == container_HIGHEST < bright
// i.e. `container_high` is DARKER than `container`, and `highest` equals
// `container`. Mapping the tiers by name gives a hover state darker than the
// surface it sits on and an active state identical to it. The ladder below is
// ordered by measured luminance, not by role name. Re-measure before changing
// it: render every role and sort, don't trust the names.
//
// green/yellow are static — Material You has no such roles (same convention as
// the kitty/foot ANSI slots).
window, * {
  --bg-base:               {{colors.surface.default.hex}};
  --bg-surface:            {{colors.surface_container_low.default.hex}};
  --bg-surface-elevated:   {{colors.surface_container_high.default.hex}};
  --bg-elevated:           {{colors.surface_container_high.default.hex}};
  --bg-overlay:            {{colors.surface_bright.default.hex}};
  --bg-hover:              {{colors.surface_container_high.default.hex}};
  --bg-active:             {{colors.surface_container.default.hex}};
  --bg-selected:           {{colors.secondary_container.default.hex}};

  --fg-default:            {{colors.on_surface.default.hex}};
  --fg-muted:              {{colors.on_surface_variant.default.hex}};
  --fg-subtle:             {{colors.outline.default.hex}};
  --fg-on-accent:          {{colors.on_primary.default.hex}};

  --accent:                {{colors.primary.default.hex}};
  --accent-subtle:         {{colors.primary_container.default.hex}};
  --accent-hover:          {{colors.primary_fixed_dim.default.hex}};

  --status-error:          {{colors.error.default.hex}};
  --status-error-subtle:   {{colors.error_container.default.hex}};
  --status-error-hover:    {{colors.error.default.hex}};
  --status-info:           {{colors.tertiary.default.hex}};
  --status-info-subtle:    {{colors.tertiary_container.default.hex}};
  --status-success:        #a6e3a1;
  --status-success-subtle: {{colors.secondary_container.default.hex}};
  --status-warning:        #f9e2af;
  --status-warning-subtle: {{colors.secondary_container.default.hex}};

  --red:                   {{colors.error.default.hex}};
  --green:                 #a6e3a1;
  --blue:                  {{colors.primary.default.hex}};
  --yellow:                #f9e2af;

  --border-default:        {{colors.outline_variant.default.hex}};
  --border-subtle:         {{colors.outline_variant.default.hex}};
  --border-strong:         {{colors.outline.default.hex}};
  --border-accent:         {{colors.primary.default.hex}};
  --border-error:          {{colors.error.default.hex}};
  --scrim:                 {{colors.scrim.default.hex}};

  --bar-bg:                {{colors.surface.default.hex}};
  --bar-border-color:      {{colors.outline_variant.default.hex}};
  --bar-container-bg:      {{colors.surface_container_low.default.hex}};
  --bar-group-bg:          {{colors.surface_container_low.default.hex}};
  --bar-btn-bg:            {{colors.surface_container_high.default.hex}};
  --bar-btn-icon-color:    {{colors.on_surface.default.hex}};
  --bar-btn-label-color:   {{colors.on_surface.default.hex}};
  --bar-btn-border-color:  {{colors.outline_variant.default.hex}};
  --bar-group-border-color:{{colors.outline_variant.default.hex}};

  --ws-active-color:       {{colors.primary.default.hex}};
  --ws-occupied-color:     {{colors.on_surface_variant.default.hex}};
  --ws-empty-color:        {{colors.outline.default.hex}};
  --ws-border-color:       {{colors.outline_variant.default.hex}};
  --ws-container-bg-color: {{colors.surface_container_low.default.hex}};
}
