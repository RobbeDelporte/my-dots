;; Wallpaper clock v2 -- see docs/superpowers/specs/2026-06-18-eww-wallpaper-clock-v2-design.md
;; A two-tone typographic clock on the BACKGROUND layer (visible on the empty
;; desktop, hidden behind windows). Two lines: a hero time over a date + weekday
;; row. Numerals = JetBrains Mono (.num), CJK unit characters = Noto Serif CJK SC
;; (.unit), dot + English weekday = Black Future (.wd/.sep). Framed by primary
;; corner brackets. Opened once per output by launch.sh; placed by reposition.sh.

;; Time refreshes every 10s; date fields hourly. The unit characters (时 分 月 日)
;; and the dot are constant literals in the widget -- only numerals + weekday poll.
(defpoll hh      :interval "10s" :initial "" `date +%H`)
(defpoll mm      :interval "10s" :initial "" `date +%M`)
(defpoll mon     :interval "1h"  :initial "" `date +%-m`)
(defpoll day     :interval "1h"  :initial "" `date +%-d`)
(defpoll weekday :interval "1h"  :initial "" `date +%A | tr '[:lower:]' '[:upper:]'`)

(defwidget clockface []
  ;; overlay = the two-line stack as the base (defines size); four corner boxes
  ;; pinned to its corners via halign/valign. Labels bottom-align (valign end) so
  ;; the smaller unit characters sit on the numerals' baseline.
  (overlay :halign "center" :valign "center"
    (box :class "clock-stack" :orientation "v" :space-evenly false :spacing 8 :halign "center" :valign "center"
      (box :class "time-row" :orientation "h" :space-evenly false :halign "center" :valign "center"
        (label :class "num"  :valign "end" :text hh)
        (label :class "unit" :valign "end" :text "时")
        (label :class "num"  :valign "end" :text mm)
        (label :class "unit" :valign "end" :text "分"))
      (box :class "meta-row" :orientation "h" :space-evenly false :halign "center" :valign "center"
        (label :class "wd"   :valign "end" :text weekday)
        (label :class "sep"  :valign "end" :text "·")
        (label :class "num"  :valign "end" :text mon)
        (label :class "unit" :valign "end" :text "月")
        (label :class "num"  :valign "end" :text day)
        (label :class "unit" :valign "end" :text "日")))
    (box :class "cnr tl" :halign "start" :valign "start")
    (box :class "cnr tr" :halign "end"   :valign "start")
    (box :class "cnr bl" :halign "start" :valign "end")
    (box :class "cnr br" :halign "end"   :valign "end")))

;; Position comes in as WINDOW ARGS (not global vars): eww evaluates :geometry
;; before global defvars are in scope, so reposition.sh passes anchor/x/y via
;; `eww open ... --arg`. Defaults here are the fallback (center right).
(defwindow clock [?anchor ?xoff ?yoff]
  :monitor 0
  :stacking "bg"
  :focusable false
  :exclusive false
  ;; Fixed size: eww/GTK won't auto-grow. Roomy enough for the centered block +
  ;; bracket padding; content is centered inside (overlay :halign/:valign center).
  :geometry (geometry
              :width "660px"
              :height "360px"
              :anchor {anchor ?: "center right"}
              :x {xoff ?: "60px"}
              :y {yoff ?: "0px"})
  (clockface))
