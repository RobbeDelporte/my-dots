# Generated by matugen — do NOT hand-edit (clobbered on every matugen run).
# ghostty colors: https://ghostty.org/docs/config/reference#background
# Included by ghostty/config.ghostty via `config-file` (last-wins over its static fallback).
# Hybrid palette, identical role mapping to kitty.tmpl: bg/fg/cursor/selection +
# neutrals + red/blue/magenta follow the matugen scheme; green/yellow/cyan are a
# static Catppuccin set because Material You has no green/yellow/cyan roles and
# matugen has no terminal_color_N roles.

background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}
cursor-color = {{colors.primary.default.hex}}
cursor-text = {{colors.on_primary.default.hex}}
selection-background = {{colors.primary_container.default.hex}}
selection-foreground = {{colors.on_primary_container.default.hex}}

# Neutrals (themed) — ascending lightness: black < bright-black < white < bright-white
palette = 0={{colors.surface_container_highest.default.hex}}
palette = 8={{colors.outline.default.hex}}
palette = 7={{colors.on_surface_variant.default.hex}}
palette = 15={{colors.on_surface.default.hex}}

# Red — matugen error role
palette = 1={{colors.error.default.hex}}
palette = 9={{colors.error.default.hex}}

# Green — curated (Catppuccin); MatYou has no green role
palette = 2=#a6e3a1
palette = 10=#a6e3a1

# Yellow — curated (Catppuccin); MatYou has no yellow role
palette = 3=#f9e2af
palette = 11=#f9e2af

# Blue — matugen primary (hue tracks the wallpaper/scheme)
palette = 4={{colors.primary.default.hex}}
palette = 12={{colors.primary.default.hex}}

# Magenta — matugen tertiary (a saturated accent; secondary is too desaturated
# and collides with the neutral whites palette 7/15)
palette = 5={{colors.tertiary.default.hex}}
palette = 13={{colors.tertiary.default.hex}}

# Cyan — curated (Catppuccin); MatYou has no cyan role
palette = 6=#94e2d5
palette = 14=#94e2d5
