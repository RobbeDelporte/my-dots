# matugen-generated mango colours -> ~/my-dots/generated/mango-colors.conf.
# Sourced by mango/config.conf AFTER the tracked colors.conf fallback, so these
# lines win. mango's colour format is 0xRRGGBBAA -- hence hex_stripped plus an
# explicit alpha byte (Hyprland's rgba($primarye6) becomes 0x<primary>e6).
rootcolor=0x{{colors.surface_container.default.hex_stripped}}ff
bordercolor=0x{{colors.on_surface_variant.default.hex_stripped}}11
focuscolor=0x{{colors.primary.default.hex_stripped}}e6
shadowscolor=0x{{colors.surface.default.hex_stripped}}d4
urgentcolor=0x{{colors.error.default.hex_stripped}}ff
scratchpadcolor=0x{{colors.tertiary.default.hex_stripped}}ff
globalcolor=0x{{colors.secondary.default.hex_stripped}}ff
overlaycolor=0x{{colors.tertiary.default.hex_stripped}}ff
maximizescreencolor=0x{{colors.primary_container.default.hex_stripped}}ff
dropcolor=0x{{colors.primary.default.hex_stripped}}55
splitcolor=0x{{colors.tertiary.default.hex_stripped}}ff
