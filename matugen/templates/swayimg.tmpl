-- Generated by matugen — do NOT hand-edit (clobbered on every render).
-- Source of truth: ~/.config/matugen/templates/swayimg.tmpl (tracked in my-dots).
-- swayimg 5.x loads this init.lua fresh on each launch (like rofi). It layers on
-- top of built-in defaults: we set matugen colors and add an "e" annotate bind.
-- Colors are ARGB, alpha-first: 0xAARRGGBB.

-- Viewer colors
swayimg.viewer.set_window_background(0xff{{colors.surface.default.hex_stripped}})
swayimg.viewer.set_image_chessboard(20, 0xff{{colors.surface_container.default.hex_stripped}}, 0xff{{colors.surface_container_high.default.hex_stripped}})
swayimg.viewer.set_mark_color(0xff{{colors.primary.default.hex_stripped}})

-- Text overlay colors
swayimg.text.set_foreground(0xff{{colors.on_surface.default.hex_stripped}})
swayimg.text.set_background(0xcc{{colors.surface.default.hex_stripped}})

-- Gallery colors
swayimg.gallery.set_window_color(0xff{{colors.surface.default.hex_stripped}})
swayimg.gallery.set_unselected_color(0xff{{colors.surface_container.default.hex_stripped}})
swayimg.gallery.set_selected_color(0xff{{colors.primary_container.default.hex_stripped}})
swayimg.gallery.set_border_color(0xff{{colors.primary.default.hex_stripped}})

-- Annotate: send the current image to satty. POSIX-escape single quotes in the
-- path (' -> '\'') so odd filenames (spaces, apostrophes) don't break the shell.
-- The backslash is built via string.char(92) because matugen collapses literal
-- backslashes on render — a literal "\\" here would reach Lua as just "\".
local BS = string.char(92)
local function shq(p) return "'" .. p:gsub("'", "'" .. BS .. "''") .. "'" end
swayimg.viewer.on_key("e", function()
  os.execute("satty --filename " .. shq(swayimg.viewer.get_image().path) .. " &")
end)
swayimg.gallery.on_key("e", function()
  os.execute("satty --filename " .. shq(swayimg.gallery.get_image().path) .. " &")
end)
