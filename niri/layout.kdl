// Layout sizing — mirrors gaps/border feel from hypr/hyprland/variables.conf.
// Colors for focus-ring/border live in colors-fallback.kdl + the matugen include;
// niri deep-merges these `layout` blocks, so this file owns only the sizing.
layout {
    gaps 8                              // hypr ran tight gaps (in 2 / out 4); 8 is the niri-equivalent feel
    center-focused-column "never"

    focus-ring {
        width 2                         // hypr border size ~1
    }
    border {
        off                             // focus-ring only (niri idiom); border still themed if you enable it
    }

    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}
