// Outputs — mirrors hypr/hyprland/monitors.conf (pragmatic).
// niri arranges outputs left-to-right automatically; set `position` for an exact
// layout, and uncomment `mode` only if niri picks the wrong resolution/refresh.
output "eDP-1" {
    scale 1.2                           // hypr: monitor = eDP-1, preferred, auto, 1.2
    // mode "1920x1080@60.000"
}

// External monitors from monitors.conf — uncomment/adjust the one you use.
// output "DP-1" {
//     mode "3440x1440@59.970"          // hypr: DP-1, 3440x1440@59.97Hz
//     scale 1.0
//     position x=1920 y=0              // place it to the right of eDP-1
// }
