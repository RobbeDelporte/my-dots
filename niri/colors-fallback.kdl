// Static fallback colors for niri. Tracked in git.
// Overridden per-key by the matugen-generated fragment (deep-merge via include).
// niri color strings require the leading '#'.
layout {
    background-color "#1e1e2e"
    focus-ring {
        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
    border {
        active-color "#89b4fa"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }
    insert-hint {
        color "#89b4fa80"
    }
    tab-indicator {
        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
}
