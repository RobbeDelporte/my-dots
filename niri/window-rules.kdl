// Window rules — pragmatic port of hypr/hyprland/rules.conf.
// niri matches app-id/title by regex. Dropped (don't translate to niri): per-window
// opacity overrides, special-workspace assignment, xwayland-popup tweaks, gaming flags.

// Rounded corners for every window (hypr: rounding 6)
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Desktop portals → floating
window-rule {
    match app-id=r#"^xdg-desktop-portal-(gtk|gnome|kde)$"#
    open-floating true
}

// File / settings / management pop-ups → floating (hypr floated these)
window-rule {
    match app-id=r#"^(org\.gnome\.Settings|org\.gnome\.FileRoller|file-roller|blueman-manager|nwg-look|org\.pulseaudio\.pavucontrol|system-config-printer|Thunar)$"#
    open-floating true
}

// Image viewer / screenshot annotator → floating (hypr: swayimg, satty, feh)
window-rule {
    match app-id=r#"^(swayimg|com\.gabm\.satty|feh)$"#
    open-floating true
}

// Common save/open dialogs by title → floating
window-rule {
    match title=r#"^(Open|Save|Select)( a)?( File| Folder| As).*$"#
    open-floating true
}

// Picture-in-Picture → floating
window-rule {
    match title=r#"[Pp]icture(.| )in(.| )[Pp]icture"#
    open-floating true
}
