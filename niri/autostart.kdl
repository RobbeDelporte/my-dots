// Autostart — mirrors hypr/hyprland/execs.conf (minus hypridle and Hyprland-only
// commands). wayle pulls in its awww wallpaper backend.
spawn-at-startup "wayle" "shell"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-at-startup "ydotoold"
spawn-sh-at-startup "gnome-keyring-daemon --start --components=secrets"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "trash-empty" "30"
spawn-at-startup "/usr/lib/geoclue-2.0/demos/agent"
spawn-sh-at-startup "sleep 1 && gammastep"
spawn-at-startup "mpris-proxy"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface cursor-theme 'sweet-cursors'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface cursor-size 24"
