// niri — main config. Mirrors the hypr/hyprland/ split: each concern is its own
// included file (niri deep-merges sections across includes, like Hyprland's `source=`).
// Pragmatic notes on what does NOT translate from Hyprland:
//   - KDL has no variables, so variables.conf has no equivalent (values are inline).
//   - niri has no special workspaces, so special.conf is dropped.
//
//   colors-fallback.kdl   static color fallback        (← hypr/colors.conf)
//   <generated>           matugen wallpaper colors      (← generated/hypr-colors.conf)
//   input.kdl             keyboard / touchpad / mouse   (← input.conf)
//   layout.kdl            gaps / borders / columns      (← variables.conf)
//   output.kdl            monitors                      (← monitors.conf)
//   window-rules.kdl      window rules                  (← rules.conf)
//   animations.kdl        animations                    (← animations.conf)
//   binds.kdl             keybinds                      (← keybinds.conf)
//   autostart.kdl         session services              (← execs.conf)

include "colors-fallback.kdl"
include optional=true "/home/robbe/my-dots/generated/niri-colors.kdl"
include "input.kdl"
include "layout.kdl"
include "output.kdl"
include "window-rules.kdl"
include "animations.kdl"
include "binds.kdl"
include "autostart.kdl"

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


hotkey-overlay {
    skip-at-startup
}

gestures {
    hot-corners {
        off
    }
}
